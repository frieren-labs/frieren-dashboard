---
interface Props {
  label: string;
  value: string;
}
const { label, value } = Astro.props;
---

<div class="rounded-xl border border-frieren-border bg-frieren-card p-4">
  <p class="text-xs uppercase tracking-wider text-frieren-muted">{label}</p>
  <p class="mt-1 font-mono text-2xl font-semibold text-frieren-text">{value}</p>
</div>
